               if str(p).isascii() and str(p).isdigit() and isinstance(i, dict) and i.get("kind") == "vnc"}
    if not screens:
        print("    No screens published right now (client: ferry expose-vnc).")
    for port, info in sorted(screens.items(), key=lambda kv: int(kv[0])):
        print(f"    Screen {info.get('label') or info.get('client', '?')}: http://{sys.argv[2]}:{sys.argv[3]}/vnc/{port}")
except Exception:
    sys.exit(0)
PYEOF
    fi
  fi

  # tmux-over-ssh: one hint per client that published its sshd with expose-tmux.
  # Reads the state file alone (a stale file is the relay's to clean up).
  if [[ -f "$RELAY_STATE_FILE" ]]; then
    python3 - "$RELAY_STATE_FILE" <<'PYEOF' || true
