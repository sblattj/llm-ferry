# Ignore macOS system files
.DS_Store

# Ignore Python caches
__pycache__/
*.pyc

# Ignore local log files
*.log

# Ignore inbound client HQ telemetry (runtime data, written by `ferry share` /hq endpoint)
client_logs.txt

# Ignore local route config (personal model ids/endpoints); use litellm-route-example.yaml as the template
litellm.yaml

# Ignore editor/agent scratch + worktrees, but DO ship the bundled Claude Code skills
.claude/*
!.claude/skills/

# Local-only docs that must never be published (handoffs, retros, incident notes)
docs/HANDOFF-*
docs/stack-retro/
# The architecture page renders THIS host's live routing: every lane's real model,
# provider, and per-token price. Lane names are the public contract; what sits
# behind them is not, and a rendered page is the easiest way to leak the whole map
# at once. Keep it local.
docs/ferry-arch.*
