  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "",
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
      "options": {
        "mode": "markdown",
        "content": "## Ferry Backends & Keys\nLitellm proxy topology (`~/.config/ferry/litellm.yaml`) and the Gemini key pool — deployments, fallback chain, config freshness — from `ferry-metrics-exporter`, scraped by VictoriaMetrics every ~15s. The **LLM internals** and **Failures & Fallbacks** rows below read litellm's own `/metrics` (`litellm_*`): the prometheus callback is **on by default now**, so they populate within one scrape of the first request — see `observ/README.md`. Per-model usage lives on the **Ferry — Models** dashboard."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Gemini key pool",
      "description": "ferry_worker_pool_size — number of deployments in litellm.yaml whose model_name is the pooled Gemini model.",
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "gridPos": { "x": 0, "y": 3, "w": 8, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#0ca30c", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "ferry_worker_pool_size",
          "legendFormat": "Gemini key pool",
          "instant": true
        }
      ]
    },
    {
