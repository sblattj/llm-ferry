          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "row",
      "title": "Failures & Fallbacks — litellm-native (prometheus callback, on by default)",
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "collapsed": false,
      "gridPos": { "x": 0, "y": 39, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 13,
      "type": "table",
      "title": "Failures by model + reason (selected range)",
      "description": "sum by (requested_model, exception_class, exception_status)(increase(litellm_proxy_failed_requests_metric_total[$__range])) — every client-facing failure by the model the client requested, with the litellm exception class and HTTP status (e.g. VertexAIError / 429). Uses the PROXY failed-requests counter, not litellm_deployment_failure_responses_total: streaming calls (agentic clients stream) do NOT increment the deployment counter, so Gemini pool 429s only show up here.",
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "gridPos": { "x": 0, "y": 40, "w": 14, "h": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#d03b3b", "value": null }]
          },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": false
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failures" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#0ca30c", "value": null },
                    { "color": "#fab219", "value": 1 },
                    { "color": "#d03b3b", "value": 5 }
                  ]
                }
              },
              { "id": "custom.width", "value": 110 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "HTTP status" },
            "properties": [{ "id": "custom.width", "value": 120 }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": true, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
            "indexByName": { "requested_model": 0, "exception_class": 1, "exception_status": 2, "Value": 3 },
            "renameByName": {
              "requested_model": "Model",
              "exception_class": "Exception",
              "exception_status": "HTTP status",
              "Value": "Failures"
            }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "Failures", "desc": true }] }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "sum by (requested_model, exception_class, exception_status) (increase(litellm_proxy_failed_requests_metric_total[$__range]))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Failure rate by model",
      "description": "sum by (requested_model)(rate(litellm_proxy_failed_requests_metric_total[$__rate_interval])) — when each model started erroring, client-facing. Flat zero is healthy; a step up is the moment a backend went bad and fallbacks began firing (see the fallback tables below). Uses the PROXY failed-requests counter so streaming 429s (e.g. the Gemini pool exhausting quota) are included.",
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "gridPos": { "x": 14, "y": 40, "w": 10, "h": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 3,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "failures/s",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#d03b3b", "value": null }]
          },
          "mappings": []
        },
        "overrides": []
