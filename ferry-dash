  from=Math.round(from); let to=Math.round(dropBefore);
  if(!(from>=1)||from>=n) return order.slice();
  if(!(to>=1)) to=1; else if(to>n) to=n;
  if(to===from||to===from+1) return order.slice();
  const next=order.slice();
  const [x]=next.splice(from,1);
  next.splice(to>from?to-1:to,0,x);
  return next;
}
// dropIndexFromY: which insert-before slot does a pointer at y land in, given
// the vertical midpoints of the fallback rows? Slot i+1 sits above row i,
// slot len+1 below the last row. There is deliberately no slot 0 — the
// primary row is never a drop target.
function dropIndexFromY(centers,y){
  for(let i=0;i<centers.length;i++) if(y<centers[i]) return i+1;
  return centers.length+1;
}
// Candidates for "+ add hop": anything the catalogue serves that this lane
// neither is nor already falls back through.
function availHops(groups,lane,order){
  return Object.keys(groups).filter(g=>g!==lane&&!order.includes(g)).sort();
}
function sameJSON(a,b){return JSON.stringify(a)===JSON.stringify(b);}
// ── end pure order helpers ─────────────────────────────────────────────────

const laneKind=g=>(GROUPS[g]&&GROUPS[g].count>1)
  ? 'pool · '+GROUPS[g].count+' deployments share this name'
  : 'ordered chain';
const modelOf=g=>shortModel(((GROUPS[g]||{}).models||[])[0]||'');

function routesDirty(){
  if(!EDIT||!SERVER) return false;
  return !sameJSON(EDIT,SERVER);
}

function renderRoutes(st){
  if(DRAG||PICKER_OPEN) return;   // never rebuild the DOM under a live gesture
  const t=st.topology||{}; GROUPS=t.groups||{};
  const fb=t.fallbacks||{};
  // Editable lanes: anything with a chain, plus anything the catalogue serves.
  // A served lane with no chain (the local GPU lanes) belongs here too — its
  // empty chain is a deliberate choice worth SEEING, not an absence.
  const lanes=[...new Set([...Object.keys(fb),...(st.models||[])])]
    .filter(l=>GROUPS[l]).sort();
  // SERVER must carry the SAME key set as EDIT or the dirty comparison is
  // unequal from the first render: a lane with no fallbacks entry is just the
  // lane itself ([lane]) here, not missing. Getting this wrong made the
  // editor claim unsaved edits on load, which also froze the poll (tick skips
  // reseeding while dirty).
  SERVER={}; lanes.forEach(l=>SERVER[l]=[l,...(fb[l]||[])]);
  if(EDIT===null){ EDIT={}; lanes.forEach(l=>EDIT[l]=[l,...(fb[l]||[])]); }

  $('#routespath').textContent=st.config_path||'';
  const box=$('#routesbody'); box.innerHTML=''; box.className='';
  if(!lanes.length){ box.className='muted'; box.textContent=t.error||'no lanes found'; return; }

  lanes.forEach(lane=>{
    const order=EDIT[lane]||(EDIT[lane]=[lane]);
    const sec=el('div','lane');
    const h=el('h3',null,lane);
    h.appendChild(el('span','kind',laneKind(lane)));
    if(!sameJSON(order,SERVER[lane])) h.appendChild(el('span','dirty',' · modified'));
    sec.appendChild(h);

    const list=el('div','hops'); list.setAttribute('role','list');
    // Position 0 — the primary. Pinned: not draggable, never a drop target,
    // so the pinned posture the backend enforces is impossible to violate
    // rather than merely error-prone.
    const p=el('div','hop hoprow primary'); p.setAttribute('role','listitem');
    p.appendChild(el('span','idx','0'));
    const star=el('span','star','★'); star.title='primary — pinned'; p.appendChild(star);
    const pw=el('div','who'); pw.appendChild(el('b',null,modelOf(lane)||lane));
    pw.appendChild(el('span',null,lane));
    p.appendChild(pw);
    p.appendChild(el('span','ptag','PRIMARY'));
    // draggable=false means no dragstart ever fires, so the hint rides a
    // mousedown + pull instead: the moment the user hauls on the row, say why
    // nothing happens.
    p.addEventListener('mousedown',e=>{
      const sx=e.clientX, sy=e.clientY;
      const mv=ev=>{ if(Math.abs(ev.clientX-sx)+Math.abs(ev.clientY-sy)>6){pinHint(sec);cleanup();} };
      const cleanup=()=>{document.removeEventListener('mousemove',mv);
                         document.removeEventListener('mouseup',up);};
      const up=()=>cleanup();
      document.addEventListener('mousemove',mv); document.addEventListener('mouseup',up);
    });
    list.appendChild(p);

    // Positions 1..n — the fallback hops, one draggable row each. ↑/↓ stay as
    // the keyboard-accessible path; drag is the primary gesture.
    const fbrows=[];
    const centers=()=>fbrows.map(r=>{const b=r.getBoundingClientRect();
                                     return b.top+b.height/2;});
    for(let i=1;i<order.length;i++){
      const hop=order[i];
      const r=el('div','hop hoprow'); r.setAttribute('role','listitem');
      r.draggable=true;
      r.appendChild(el('span','idx',String(i)));
      const grip=el('span','grip','⠿'); grip.title='drag to reorder'; r.appendChild(grip);
      const w=el('div','who'); w.appendChild(el('b',null,modelOf(hop)||hop));
      w.appendChild(el('span',null,hop+(GROUPS[hop]&&GROUPS[hop].count>1?' · pool':'')));
      r.appendChild(w);
      const up=el('button','mini','↑'); up.title='move up';
      up.setAttribute('aria-label','move '+hop+' up'); up.disabled=(i===1);
      up.onclick=()=>{EDIT[lane]=moveHop(order,i,i-1);redraw();};
      const dn=el('button','mini','↓'); dn.title='move down';
      dn.setAttribute('aria-label','move '+hop+' down'); dn.disabled=(i===order.length-1);
      dn.onclick=()=>{EDIT[lane]=moveHop(order,i,i+2);redraw();};
      const rm=el('button','mini rm','×'); rm.title='remove hop';
      rm.setAttribute('aria-label','remove '+hop);
      rm.onclick=()=>{order.splice(i,1);redraw();};
      r.appendChild(up); r.appendChild(dn); r.appendChild(rm);
      r.addEventListener('dragstart',e=>{
        DRAG={lane:lane,from:i};
        try{e.dataTransfer.setData('text/plain',hop);}catch(err){}
        e.dataTransfer.effectAllowed='move';
        r.classList.add('dragging'); sec.classList.add('dropping');
      });
      r.addEventListener('dragend',()=>endDrag(sec));
      list.appendChild(r); fbrows.push(r);
    }

    // The drop zone is THIS lane's list and nothing else: a hop from another
    // lane never preventDefaults here, so the browser refuses the drop and a
    // chain cannot leak across lanes.
    list.addEventListener('dragover',e=>{
      if(!DRAG||DRAG.lane!==lane) return;
      e.preventDefault(); e.dataTransfer.dropEffect='move';
      const idx=dropIndexFromY(centers(),e.clientY);
      fbrows.forEach((row,k)=>{
        const on=row!==fbrows[DRAG.from-1];
        row.classList.toggle('drop-before',on&&idx===k+1);
        row.classList.toggle('drop-after',on&&idx===fbrows.length+1&&k===fbrows.length-1);
      });
    });
    list.addEventListener('dragleave',e=>{
      if(e.relatedTarget&&list.contains(e.relatedTarget)) return;
      fbrows.forEach(row=>row.classList.remove('drop-before','drop-after'));
    });
    list.addEventListener('drop',e=>{
      if(!DRAG||DRAG.lane!==lane) return;
      e.preventDefault();
      const idx=dropIndexFromY(centers(),e.clientY);
      EDIT[lane]=moveHop(order,DRAG.from,idx);
      endDrag(sec); redraw();
    });
    sec.appendChild(list);
    sec.appendChild(el('div','pinhint',
      'the primary (position 0) is pinned — drag the fallback hops below it to reorder'));

    const avail=availHops(GROUPS,lane,order);
    if(avail.length){
      const add=el('div','addhop');
      const btn=el('button','mini add','+ add hop');
      btn.setAttribute('aria-expanded','false');
      const pick=el('div','picker'); pick.style.display='none';
      btn.onclick=()=>{
        PICKER_OPEN=pick.style.display==='none';
        pick.style.display=PICKER_OPEN?'':'none';
        btn.setAttribute('aria-expanded',String(PICKER_OPEN));
      };
      avail.forEach(g=>{
        const b=el('button','mini pick',g+'  ·  '+(modelOf(g)||'?'));
        b.onclick=()=>{PICKER_OPEN=false;order.push(g);redraw();};
        pick.appendChild(b);
      });
      add.appendChild(btn); add.appendChild(pick);
      sec.appendChild(add);
    }
    box.appendChild(sec);
  });

  $('#routesact').style.display='';
  $('#applybtn').disabled=true;          // Apply unlocks only after a preview
  $('#previewbtn').disabled=!routesDirty();
}
function endDrag(sec){
  if(sec){ sec.classList.remove('dropping');
    sec.querySelectorAll('.hop').forEach(r=>r.classList.remove('drop-before','drop-after')); }
  const d=document.querySelector('.dragging'); if(d) d.classList.remove('dragging');
  DRAG=null;
}
function pinHint(sec){
  const h=sec&&sec.querySelector('.pinhint'); if(!h) return;
  h.classList.add('show'); clearTimeout(h._t);
  h._t=setTimeout(()=>h.classList.remove('show'),2400);
}
function redraw(){ renderRoutes(LAST||{}); }

async function postRoutes(url){
  const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},
                           body:JSON.stringify({order:EDIT})});
  return {code:r.status, body:await r.json()};
}
function showDiff(d){
  const pre=$('#routesdiff'); pre.innerHTML=''; pre.style.display=d?'':'none';
  (d||'').split('\n').forEach(l=>{
    // `+++ proposed` / `--- current` are FILE HEADERS, not changed lines. Test
    // them before the single-character checks or the diff reads as two extra
    // edits that are not in the config.
    const c=(l.startsWith('+++')||l.startsWith('---'))?'hunk'
           :l.startsWith('+')?'add':l.startsWith('-')?'del'
           :l.startsWith('@')?'hunk':'';
    pre.appendChild(el('div',c,l));
  });
}
function msg(text,cls){ const m=$('#routesmsg'); m.className=cls||''; m.textContent=text||''; }

// -- live view --------------------------------------------------------------
// Fed by /api/events (per-request, sub-second) plus /status (topology and
// per-deployment state). The server folds each event into the exhaustion state
// before framing it, so the stream and the poll cannot disagree.
const FEED_CAP=200;          // a long session must not grow the DOM without bound
const FLASH_MS=6000;         // how long an edge stays lit after the request
const STICKY=['quota_exhausted','auth_dead'];
const LIVE={events:[], flash:{}, es:null, fails:0, showAll:false};

const hhmm=sec=>{const d=new Date((sec||0)*1000);return isNaN(d)?'—':d.toTimeString().slice(0,5);};
const clock=t=>{const d=new Date(t);return isNaN(d)?'--:--:--':d.toLocaleTimeString();};

// Stats come from the feed buffer, so they describe what THIS page has seen
// since it loaded - never a claim about history the dash does not have.
function depStats(id){
  if(!id) return {rpm:0,p50:null};
  const now=Date.now(), rows=LIVE.events.filter(e=>e.deployment===id);
  const durs=rows.slice(0,20).map(e=>e.duration_ms)
                 .filter(v=>typeof v==='number').sort((a,b)=>a-b);
  return {rpm:rows.filter(e=>now-e._ms<60000).length,
          p50:durs.length?durs[Math.floor(durs.length/2)]:null};
}

// An event names the deployment that SUCCEEDED and, in hop_errors, the ones
// tried before it. `fallbacks` is the count, and it can be non-zero while
// hop_errors is empty (the header carrying the detail is not guaranteed), so
// the count decides how many edges light and the codes fill in where they exist.
function noteFlash(e){
  const n=Math.max((e.hop_errors||[]).length, e.fallbacks||0), failed={};
  for(let i=0;i<n;i++){
    const h=(e.hop_errors||[])[i]||{};
    failed[i]=h.code?String(h.code):'failed';
  }
  LIVE.flash[e.lane]={ts:Date.now(), served:e.deployment, failed:failed};
}

function depChip(d,st){
  const info=(st.deployments||{})[d.id];
  const state=info?info.state:'';
  const c=el('span','chip'+(state?' '+state:''));
  const s=depStats(d.id), bits=[shortModel(d.model||d.id||'?')];
  if(state) bits.push(state.replace(/_/g,' '));
  if(s.rpm) bits.push(s.rpm+'/min');
  if(s.p50!=null) bits.push(Math.round(s.p50)+'ms');
  if(info && info.code) bits.push(info.code);
  if(info && STICKY.indexOf(state)>=0) bits.push('since '+hhmm(info.since));
  c.textContent=bits.join(' · ');
  c.title=[d.id||'', d.model||'', d.provider||'', (info&&info.detail)||'']
            .filter(Boolean).join('\n');
  return c;
}

function hopBox(lane,hop,i,st,fresh){
  const b=el('div','hopb'), f=LIVE.flash[lane.name];
  const ids=(hop.deployments||[]).map(d=>d.id).filter(Boolean);
  if(hop.missing) b.classList.add('missing');
  if(fresh){
    if(f.served && ids.indexOf(f.served)>=0) b.classList.add('served');
    else if(f.failed[i]!==undefined) b.classList.add('failed');
  }
  const head=el('div');
  head.appendChild(el('b',null,hop.name));
  if(hop.missing) head.appendChild(el('span','pool','not defined in the config'));
  else if(hop.is_pool) head.appendChild(el('span','pool','pool ×'+hop.pool_size));
  b.appendChild(head);
  if((hop.deployments||[]).length){
    const chips=el('div','chips');
    hop.deployments.forEach(d=>chips.appendChild(depChip(d,st)));
    b.appendChild(chips);
  }
  return b;
}

function renderLive(st){
  const tap=st.tap||{}, lanes=st.lanes||[], off=$('#tapoff');
  // Degrade honestly: an empty graph looks exactly like no traffic, so say
  // which of the two this is.
  if(!tap.path){
    off.style.display='';
    off.textContent='event tap is off — restart ferry with FERRY_EVENTS=on, and point the dash at the file with --events';
  }else if(LIVE.fails>2){
    off.style.display='';
    off.textContent='event stream disconnected — the dash cannot read '+tap.path;
  }else if(!tap.writing){
    off.style.display='';
    off.textContent='tap armed, nothing written yet — '+tap.path;
  }else{ off.style.display='none'; }
  $('#livemeta').textContent=tap.rules?'':'(no classifier table — every failure reads as "unknown")';

  const box=$('#livelanes'); box.innerHTML=''; box.className='';
  if(!lanes.length){ box.className='muted'; box.textContent='no lanes parsed from the config'; }
  const shown=LIVE.showAll?lanes:lanes.filter(l=>l.public);
  shown.forEach(l=>{
    const f=LIVE.flash[l.name], fresh=!!f && Date.now()-f.ts<FLASH_MS;
    const hdr=el('div','lanehdr');
    hdr.appendChild(el('b',null,l.name));
    hdr.appendChild(el('span','sub',l.public?'public':'internal'));
    if(fresh) hdr.appendChild(el('span','tag active','live'));
    box.appendChild(hdr);
    const chain=el('div','chain');
    l.hops.forEach((h,i)=>{
      if(i){
        const failed=fresh && f.failed[i-1]!==undefined;
        chain.appendChild(el('span','edge'+(failed?' failed':''),
                             failed?('→ '+f.failed[i-1]+' →'):'→'));
      }
      chain.appendChild(hopBox(l,h,i,st,fresh));
    });
    box.appendChild(chain);
  });
  const hidden=lanes.length-shown.length;
  $('#showall').textContent=LIVE.showAll
    ? 'public lanes only'
    : (hidden?('show all lanes (+'+hidden+')'):'show all lanes');
}

function renderFeed(){
  const box=$('#feed'); box.innerHTML='';
  LIVE.events.forEach(e=>{
    const r=el('div','fr'), ok=e.status>=200&&e.status<300;
    r.appendChild(el('span','t',clock(e.t)));
    r.appendChild(el('span','st '+(ok?'ok':'bad'),String(e.status||'—')));
    const w=el('span','w');
    w.textContent=(e.lane||'?')+' → '+shortModel(e.deployment||e.model)
      +(e.provider?' ('+e.provider+')':'')
      +(e.fallbacks?'  ↳ after '+e.fallbacks+' fallback'+(e.fallbacks>1?'s':''):'')
      +(e.retries?'  ↻'+e.retries:'');
    r.appendChild(w);
    r.appendChild(el('span','t',e.duration_ms!=null?Math.round(e.duration_ms)+'ms':''));
    box.appendChild(r);
  });
  const n=LIVE.events.length;
  $('#feedmeta').textContent=n
    ? (n+' request'+(n===1?'':'s')+' since this page loaded'+(n>=FEED_CAP?' (capped)':''))
    : 'no requests seen since this page loaded';
}

function openStream(st){
  if(LIVE.es || !((st.tap||{}).path)) return;
  let es;
  try{ es=new EventSource('/api/events'); }catch(err){ return; }
  LIVE.es=es;
  es.onopen=()=>{ LIVE.fails=0; };
  es.onmessage=m=>{
    let e; try{ e=JSON.parse(m.data); }catch(err){ return; }
    e._ms=Date.parse(e.t)||Date.now();
    LIVE.events.unshift(e);
    if(LIVE.events.length>FEED_CAP) LIVE.events.length=FEED_CAP;
    noteFlash(e); renderFeed();
    if(LAST) renderLive(LAST);
  };
  es.onerror=()=>{
    LIVE.fails++;
    // EventSource reconnects on its own, but a tap that is off answers 503 to
    // every attempt forever. Close after a few and let the 5s poll retry, so
    // the failure shows up in the banner instead of hiding in a retry loop.
    if(LIVE.fails>3){ try{es.close();}catch(err){} LIVE.es=null; }
    if(LAST) renderLive(LAST);
  };
}
$('#showall').onclick=()=>{ LIVE.showAll=!LIVE.showAll; if(LAST) renderLive(LAST); };

let LAST=null;

async function tick(){
  try{
    const st=await (await fetch('/status')).json();
    LAST=st;
    const f=st.ferry;
    $('#host').innerHTML='<span class="muted">'+f.host+':'+f.port+'</span> &nbsp; '+
      '<span class="muted">groups:</span> '+(st.models||[]).map(m=>'<code>'+m+'</code>').join(' ');
    const pill=$('#uppill'); pill.className='pill '+(f.up?'up':'down'); pill.textContent=f.up?'● UP':'● DOWN';
    $('#updated').textContent='updated '+new Date(st.ts*1000).toLocaleTimeString();
    $('#foot').innerHTML='config <code>'+st.config_path+'</code> &nbsp;·&nbsp; log <code>'+((st.activity||{}).log||'—')+'</code> &nbsp;·&nbsp; auto-refresh 5s (no tokens)';
    renderOrch(st); renderWork(st); renderAct(st); renderLive(st);
    openStream(st);
    // Only reseed the editor when the user has no unsaved edit. A 5s poll that
    // re-rendered mid-edit would drop a half-built chain and reset the Apply
    // button under the user's cursor.
    if(!routesDirty()) renderRoutes(st);
  }catch(e){ $('#uppill').className='pill down'; $('#uppill').textContent='● dash error'; }
}
$('#testbtn').onclick=async()=>{
  const b=$('#testbtn'); b.disabled=true; b.textContent='probing…';
  const pb=$('#probebody'); pb.innerHTML='';
  try{
    PROBE=await (await fetch('/probe')).json();
    Object.entries(PROBE).forEach(([k,v])=>{
