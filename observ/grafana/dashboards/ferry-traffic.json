{
  "title": "Ferry Traffic",
  "uid": "ferry-traffic",
  "tags": ["llm-ferry", "traffic"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "style": "dark",
  "liveNow": false,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "15s",
  "timezone": "browser",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "**Ferry Traffic** — per-client / per-status LAN request traffic for the llm-ferry relay, parsed from the litellm proxy access log (`/v1/chat/completions` only; `/v1/models` and `/health` polls are excluded). Request rate by status and by client, the top clients over the window, the status-code mix, and the rolling error rate. Source: `ferry-metrics-exporter` → VictoriaMetrics (`ferry_requests_total{client,status}`, a cumulative counter). _Note: these series accrue forward from the exporter's first scrape — there is no historical backfill._"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "sum by (status)(rate(ferry_requests_total[1m]))",
          "legendFormat": "{{status}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 25,
            "gradientMode": "none",
            "spanNulls": false,
            "pointSize": 5,
            "stacking": { "mode": "normal", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#0ca30c", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/^2\\d\\d$/" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^4\\d\\d$/" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#eb6834" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^5\\d\\d$/" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request rate by client",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "sum by (client)(rate(ferry_requests_total[1m]))",
          "legendFormat": "{{client}}",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#2a78d6", "value": null }] }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top clients (last 6h)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "sum by (client)(increase(ferry_requests_total[6h]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true },
            "indexByName": { "client": 0, "Value": 1 },
            "renameByName": { "client": "Client", "Value": "Requests" }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [{ "displayName": "Requests", "desc": true }],
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "mappings": [],
          "custom": { "cellOptions": { "type": "auto" }, "align": "auto", "inspect": false },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#0ca30c", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Requests" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient", "valueDisplayMode": "text" } },
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#2a78d6" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Client" },
            "properties": [{ "id": "custom.width", "value": 220 }]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Status-code breakdown (6h)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 11 },
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "sum by (status)(increase(ferry_requests_total[6h]))",
          "legendFormat": "{{status}}",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "pieType": "pie",
        "displayLabels": ["percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#0ca30c", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "/^2\\d\\d$/" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0ca30c" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^4\\d\\d$/" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#eb6834" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "/^5\\d\\d$/" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#d03b3b" } }]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error rate %",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "100 * sum(rate(ferry_requests_total{status=~\"[45]..\"}[5m])) / clamp_min(sum(rate(ferry_requests_total[5m])),0.0001)",
          "legendFormat": "error rate",
          "instant": false,
          "format": "time_series"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "#d03b3b" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "none",
            "spanNulls": false,
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#0ca30c", "value": null },
              { "color": "#fab219", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Total requests (6h)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "sum(increase(ferry_requests_total[6h]))",
          "instant": true,
          "format": "time_series"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#1baf7a", "value": null }] }
        },
        "overrides": []
      }
    }
  ]
}
