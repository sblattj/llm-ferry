      const c=el('div'); c.appendChild(el('div','name',k));
      c.appendChild(el('div','sub', v.ok? ('→ '+shortModel(v.served_by)+' · '+v.ms+'ms · HTTP '+v.status)
                                        : ('HTTP '+v.status+' · '+(v.error||'failed')) ));
      line.appendChild(c); pb.appendChild(line);
    });
