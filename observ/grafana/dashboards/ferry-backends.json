    {
      "id": 7,
      "type": "text",
      "title": "",
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "gridPos": { "x": 0, "y": 20, "w": 24, "h": 3 },
      "options": {
        "mode": "markdown",
        "content": "**On by default.** The four panels below read litellm's own `/metrics` endpoint (`http://127.0.0.1:8090/metrics`), which ferry now enables out of the box (`callbacks: [\"prometheus\"]` in `~/.config/ferry/litellm.yaml`). Metric names are verified against **litellm 1.97.0** — counters carry the `_total` suffix. **No data** here means either no traffic in the selected range, or the callback was removed from litellm.yaml (re-add it and `ferry down && ferry up --route`) — see `observ/README.md`."
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Request latency p50/p95",
      "description": "litellm-native. histogram_quantile over litellm_request_total_latency_metric_bucket, aggregated across all models. Per-model p50/p95 is on the Ferry — Models dashboard.",
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 6,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#2a78d6" } },
              { "id": "custom.lineStyle", "value": { "fill": "solid" } }
            ]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "B" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#eb6834" } },
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "histogram_quantile(0.5, sum by (le)(rate(litellm_request_total_latency_metric_bucket[5m])))",
          "legendFormat": "p50",
          "instant": false
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "histogram_quantile(0.95, sum by (le)(rate(litellm_request_total_latency_metric_bucket[5m])))",
          "legendFormat": "p95",
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Tokens/min",
      "description": "litellm-native. sum(rate(litellm_total_tokens_metric_total[1m])) * 60 — total tokens/min across all models. Per-model token throughput is on the Ferry — Models dashboard.",
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 6,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "never",
            "pointSize": 5,
            "stacking": { "mode": "none", "group": "A" },
            "axisPlacement": "auto",
            "axisLabel": "",
            "scaleDistribution": { "type": "linear" },
            "hideFrom": { "tooltip": false, "viz": false, "legend": false },
            "thresholdsStyle": { "mode": "off" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "A" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "#1baf7a" } },
              { "id": "custom.lineStyle", "value": { "fill": "solid" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "sum(rate(litellm_total_tokens_metric_total[1m])) * 60",
          "legendFormat": "Tokens/min",
          "instant": false
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Per-model success/failure (client-facing)",
      "description": "litellm-native. increase(litellm_proxy_total_requests_metric_total{status_code=~\"2..\"}[$__range]) vs increase(litellm_proxy_failed_requests_metric_total[$__range]), summed by requested_model and joined into one row per model over the selected range. Uses the PROXY counters (keyed by the model the client requested) so streaming calls — including Gemini pool 429s — are counted; the litellm_deployment_* counters miss streaming.",
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "gridPos": { "x": 0, "y": 31, "w": 16, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "#0ca30c", "value": null }]
          },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Successes" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#d03b3b", "value": null },
                    { "color": "#0ca30c", "value": 1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Failures" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-text" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "#0ca30c", "value": null },
                    { "color": "#fab219", "value": 1 },
                    { "color": "#d03b3b", "value": 5 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          },
          {
            "matcher": { "id": "byName", "options": "Time 1" },
            "properties": [{ "id": "custom.hidden", "value": true }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "__name__": true,
              "__name__ 1": true,
              "instance": true,
              "instance 1": true,
              "job": true,
              "job 1": true
            },
            "indexByName": { "requested_model": 0, "Value": 1, "Value 1": 2 },
            "renameByName": { "requested_model": "Model", "Value": "Successes", "Value 1": "Failures" }
          }
        },
        {
          "id": "sortBy",
          "options": { "fields": {}, "sort": [{ "field": "Failures", "desc": true }] }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "sum by (requested_model) (increase(litellm_proxy_total_requests_metric_total{status_code=~\"2..\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "ferry-vm" },
          "expr": "sum by (requested_model) (increase(litellm_proxy_failed_requests_metric_total[$__range]))",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Spend",
      "description": "litellm-native. sum(litellm_spend_metric_total) — cumulative USD spend litellm has attributed since the proxy started. Per-model spend over a chosen range is on the Ferry — Models dashboard.",
      "datasource": { "type": "prometheus", "uid": "ferry-vm" },
      "gridPos": { "x": 16, "y": 31, "w": 8, "h": 8 },
