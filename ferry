  echo "      ... /client-bootstrap.sh | zsh -s -- --no-claude       (skip the Claude Code wrappers)"
  echo "      ... /client-bootstrap.sh | zsh -s -- --no-cline        (skip the Cline (VS Code) wiring)"
  echo ""
