  if [[ "$CLIENT_MODE" == "1" ]]; then
    base="http://$CLIENT_HOST:$CLIENT_PORT"
    key="$CLIENT_MASTER_KEY"
  else
    base="http://127.0.0.1:$PORT"
    key="${LITELLM_MASTER_KEY:-}"
    route_config="$DEFAULT_ROUTE_CONFIG"
  fi

